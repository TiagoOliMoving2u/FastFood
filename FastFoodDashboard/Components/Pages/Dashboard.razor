@page "/dashboard/{View?}"
@using System.Net
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using FastFoodDashboard.Models
@using FastFoodDashboard.Services
@using Microsoft.AspNetCore.Hosting
@using DashboardModel = FastFoodDashboard.Models.Dashboard
@inject IWebHostEnvironment HostEnvironment
@inject IHttpClientFactory HttpClientFactory
@inject BrowserAuthStorage BrowserAuthStorage
@inject NavigationManager Navigation
@inject SignalRService SignalRService
@inject DashboardApiService DashboardApiService
@inject PermissionApiService PermissionApiService
@implements IAsyncDisposable



<nav class="dashboard-nav">
    @foreach(var dashboard in dashboards)
    {
        <NavLink href="@($"/dashboard/{dashboard.Slug}")">
            @dashboard.Name
        </NavLink>
        <text>&nbsp;</text>
    }

</nav>


@if (Expired)
{
    <p class="text-warning">
        A tua sessão expirou. Inicia sessão novamente.
    </p>
}
else{
    @if (!accessChecked)
    {
        <p>A verificar permissões...</p>
    }

    else
    {

        @if (dashboardConfig is null)
        {
            <p>Dashboard não encontrado.</p>
        }
        else
        {
            <PageTitle>@dashboardConfig.Title</PageTitle>

            <h1>@dashboardConfig.Title</h1>

            <p>SignalR: @connectionStatus</p>

            <button @onclick="LoadOrders" disabled="@loading">
                Atualizar pedidos
            </button>

            <button @onclick="LogoutAsync">
                Terminar sessão
            </button>

            @if (loading)
            {
                <p>A carregar pedidos...</p>
            }

            @if (error is not null)
            {
                <p class="text-danger">@error</p>
            }

            <div class="dashboard-grid">
                @foreach (var state in VisibleStates)
                {
                    var filteredOrders = orders
                        .Where(o => o.State == state.Id)
                        .ToList();

                    <section class="state-column">
                        <h3>@state.Name (@filteredOrders.Count)</h3>

                        @if (filteredOrders.Count == 0)
                        {
                            <p>Sem pedidos</p>
                        }
                        else
                        {
                            @foreach (var order in filteredOrders)
                            {
                                <article class="order-card">
                                    <strong>@order.Code</strong>

                                    @if (dashboardConfig.ShowAreaName)
                                    {
                                        <p>@order.AreaName</p>
                                    }
                                    @foreach (var item in order.Items){

                                        <p>@item.ToString()</p>
                                    }

                                    @if (CanChangeOrderState(order, -1))
                                    {
                                        <button class="btn btn-secondary"
                                                @onclick="() => NextState(order.Id, -1, (int)order.State)">
                                            Voltar
                                        </button>
                                    }

                                    @if (CanChangeOrderState(order, 1))
                                    {
                                        <button class="btn btn-primary"
                                                @onclick="() => NextState(order.Id, 1, (int)order.State)">
                                            Avançar
                                        </button>
                                    }

                                </article>
                            }
                        }
                    </section>
                }
            </div>
        }
    }
}

@code {
    [Parameter]
    public string? View { get; set; }

    [SupplyParameterFromQuery(Name = "expired")]
    private bool Expired { get; set; }

    private DashboardConfig? dashboardConfig;

    private IReadOnlyList<DashboardModel> dashboards = new List<DashboardModel>();

    private List<OrderDto> orders = new();

    private HashSet<string> userPermissions = new(StringComparer.OrdinalIgnoreCase);


    private string connectionStatus = "A iniciar...";

    private bool loading;
    private string? error;

    private bool accessChecked;
    private bool checkingAccess;
    private string? checkedView;

    private IEnumerable<(int Id, string Name)> VisibleStates =>
    states.Where(s => dashboardConfig?.VisibleStates.Contains(s.Id) == true);

    protected override void OnParametersSet()
    {

        var view = string.IsNullOrWhiteSpace(View)
    ? dashboards.FirstOrDefault()?.Slug
    : View.Trim();

        if (checkedView != view)
        {
            accessChecked = false;

        }

        orders.Clear();
        error = null;

        SelectDashboard();

    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var view = string.IsNullOrWhiteSpace(View)
    ? dashboards.FirstOrDefault()?.Slug
    : View.Trim();

        // Evitar verificações repetidas
        if (checkingAccess ||
            (accessChecked && checkedView == view))
            return;

        checkingAccess = true;
        accessChecked = false;

        try
        {
            if (firstRender)
            {
                await GetDashboards();
                SelectDashboard();
            }

            // Terminar uma eventual ligação anterior
            await DisposeAsync();

            if (dashboardConfig is null)
            {
                error ??= "Dashboard inexistente ou sem acesso.";
                connectionStatus = "Dashboard indisponível.";
                return;
            }

            // A página pode ter mudado durante a validação
            if (view != (View ?? "sala").Trim().ToLowerInvariant())
                return;

            // Carregar apenas pedidos de um dashboard autorizado
            await LoadOrders();

            // Evitar iniciar o Hub se a página entretanto mudou
            if (view != (View ?? "sala").Trim().ToLowerInvariant())
                return;

            // Iniciar o SignalR depois da autorização
            await StartSignalRAsync(view);
        }
        catch (HttpRequestException)
        {

            connectionStatus = "Erro de comunicação com a API.";
        }
        catch (TaskCanceledException)
        {

            connectionStatus = "A ligação à API expirou.";
        }
        finally
        {
            var slug = string.IsNullOrWhiteSpace(View)
                ? dashboards.FirstOrDefault()?.Slug
                : View.Trim();

            // Só guardar a validação para a página atual
            if (view == (View ?? slug).Trim().ToLowerInvariant())
            {
                checkedView = view;
                accessChecked = true;
            }
            else
            {
                checkedView = null;

                accessChecked = false;
            }

            checkingAccess = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void SelectDashboard()
    {
        var slug = string.IsNullOrWhiteSpace(View)
        ? dashboards.FirstOrDefault()?.Slug
        : View.Trim();

        var dashboard = dashboards.FirstOrDefault(d =>
            d.IsActive == 1 &&
            string.Equals(
                d.Slug,
                slug,
                StringComparison.OrdinalIgnoreCase));

        dashboardConfig = dashboard is null
            ? null
            : new DashboardConfig
            {
                Title = $"Dashboard - {dashboard.Name}",
                AreaId = dashboard.AreaId,
                VisibleStates = dashboard.ShowStates
                    .Select(s => s.State)
                    .Distinct()
                    .OrderBy(state => state)
                    .ToArray(),
                ShowAreaName = dashboard.AreaId is null
            };
    }

    private readonly (int Id, string Name)[] states =
    {
        (1, "Pedido"),
        (2, "Em curso"),
        (3, "Aguarda levantamento"),
        (4, "Entregue")
    };

    private async Task NextState(int id, int operation, int currentState)
    {
        error = null;
        try
        {
            if (!HostEnvironment.IsDevelopment())
            {
                error = "Autenticação de utilizadores ainda não configurada.";
                return;
            }

            var token = await BrowserAuthStorage.GetTokenAsync();

            if (string.IsNullOrWhiteSpace(token))
            {
                error = "JWT de desenvolvimento não configurado.";
                await SessionExpiredAsync();
                return;
            }

            var client = HttpClientFactory
                .CreateClient("FastFoodApi");

            // Mantém o formato que já funciona no teu endpoint
            string endpoint = $"api/orders/{id}?operation={operation}&currentState={currentState}";

            using var request = new HttpRequestMessage(
                HttpMethod.Put,
                endpoint);

            request.Headers.Authorization =
                new AuthenticationHeaderValue("Bearer", token);

            using var response = await client.SendAsync(request);

            if(response.StatusCode == HttpStatusCode.Unauthorized)
            {
                await SessionExpiredAsync();
                return;
            }

            if (response.StatusCode == HttpStatusCode.Forbidden)
            {
                error = "Não tens permissão para alterar este pedido.";
                return;
            }

            if (response.StatusCode == HttpStatusCode.Conflict)
            {
                await LoadOrders();

                error = "O pedido foi alterado por outro utilizador. " +
                        "Os dados foram atualizados; verifica o estado antes de continuar.";

                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                error = $"Não foi possível atualizar o pedido. " +
                        $"Código HTTP: {(int)response.StatusCode}.";

                return;
            }

            await LoadOrders();

        }
        catch (HttpRequestException ex)
        {
            error = $"Erro de comunicação com a API: {ex.Message}";
        }
        catch (TaskCanceledException)
        {
            error = "A operação demorou demasiado tempo.";
        }

    }

    private async Task LoadOrders()
    {
        var config = dashboardConfig;

        if (config is null)
            return;

        loading = true;
        error = null;

        try
        {
            var client = HttpClientFactory
                .CreateClient("FastFoodApi");

            string endpoint = config.AreaId.HasValue
                ? $"api/orders?areaId={config.AreaId.Value}"
                : "api/orders";

            var result = await client
                .GetFromJsonAsync<List<OrderDto>>(endpoint)
                ?? new List<OrderDto>();

            if (ReferenceEquals(dashboardConfig, config))
            {
                orders = result;
            }
        }
        catch (Exception ex) when (
            ex is HttpRequestException ||
            ex is TaskCanceledException ||
            ex is System.Text.Json.JsonException)
        {
            if (ReferenceEquals(dashboardConfig, config))
            {
                error = "Não foi possível carregar os pedidos.";
            }
        }
        finally
        {
            loading = false;
        }
    }


    private async Task LogoutAsync()
    {
        // Eliminar o JWT armazenado
        await BrowserAuthStorage.LogoutAsync();

        // Terminar a ligação SignalR
        await DisposeAsync();

        // Redirecionar para o login
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    private bool CanChangeOrderState(
        OrderDto order,
        int operation)
    {
        if (operation is not (1 or -1))
            return false;

        int currentState = (int)order.State;
        int nextState = currentState + operation;

        // Validar os limites dos estados
        if (nextState < 1 || nextState > 4)
            return false;

        // Construir o código da permissão necessária
        string permissionCode =
            $"orders.transition.{currentState}.{nextState}";

        Console.WriteLine($"Verificando permissão: {permissionCode}");

        // Verificar se o utilizador tem essa permissão
        return userPermissions.Contains(permissionCode);
    }


    private async Task SessionExpiredAsync()
    {
        await BrowserAuthStorage.LogoutAsync();

        await DisposeAsync();

        Navigation.NavigateTo(
            "/login?expired=true",
            forceLoad: true);
    }

    private async Task StartSignalRAsync(string view)
    {
        try
        {
            await SignalRService.StartAsync(
                eventName: "OrdersChanged",

                onEvent: () => InvokeAsync(async () =>
                {
                    if (checkedView != view)
                        return;

                    await LoadOrders();
                    StateHasChanged();
                }),

                tokenProvider: BrowserAuthStorage.GetTokenAsync,

                onReconnected: () => InvokeAsync(async () =>
                {
                    if (checkedView != view)
                        return;

                    await LoadOrders();
                    StateHasChanged();
                }),

                onStatusChanged: status => InvokeAsync(() =>
                {
                    connectionStatus = status;
                    StateHasChanged();
                }));

            // Sincronizar alterações ocorridas durante a ligação
            await LoadOrders();
        }
        catch (Exception ex)
        {
            connectionStatus = $"Erro ao ligar: {ex.Message}";
        }
    }

    public async ValueTask DisposeAsync()
    {
        await SignalRService.StopAsync();
    }

    private async Task GetDashboards()
    {
        try
        {
            var token = await BrowserAuthStorage.GetTokenAsync();

            if (string.IsNullOrWhiteSpace(token))
            {
                error = "JWT de desenvolvimento não configurado.";
                await SessionExpiredAsync();
                return;
            }

            dashboards = await DashboardApiService.GetAllDashboards(token);

            userPermissions.Clear();

            var permissions =
                await PermissionApiService.GetMyPermissionsAsync(token);

            userPermissions = permissions.ToHashSet(
                StringComparer.OrdinalIgnoreCase);

            dashboards = await DashboardApiService.GetAllDashboards(token);
        }
        catch (HttpRequestException ex)
        {
            error = $"Erro de comunicação com a API: {ex.Message}";
        }
        catch (TaskCanceledException)
        {
            error = "A operação demorou demasiado tempo.";
        }
    }
}
