@page "/dashboard/{View?}"
@using FastFoodDashboard.Models
@using System.Net.Http.Json
@using Microsoft.AspNetCore.SignalR.Client;
@using Microsoft.AspNetCore.Hosting
@using System.Net.Http.Headers
@using FastFoodDashboard.Services
@inject IConfiguration Configuration
@inject IWebHostEnvironment HostEnvironment
@inject IHttpClientFactory HttpClientFactory
@inject BrowserAuthStorage BrowserAuthStorage
@inject AuthApiService AuthApiService
@implements IAsyncDisposable
@inject NavigationManager Navigation



<nav class="dashboard-nav">
    <NavLink href="/dashboard/sala">Sala</NavLink>
    <NavLink href="/dashboard/esplanada">Esplanada</NavLink>
    <NavLink href="/dashboard/cozinha">Cozinha</NavLink>
    <NavLink href="/dashboard/balcao">Balcão</NavLink>
</nav>


@if (Expired)
{
    <p class="text-warning">
        A tua sessão expirou. Inicia sessão novamente.
    </p>
}
else{
    @if (!accessChecked)
    {
        <p>A verificar permissões...</p>
    }
    else if (!canAccess)
    {
        <p>Não tens permissão para aceder a este dashboard.</p>
        <a href="/login">Ir para o login</a>
    }
    else
    {

        @if (dashboardConfig is null)
        {
            <p>Dashboard não encontrado.</p>
        }
        else
        {
            <PageTitle>@dashboardConfig.Title</PageTitle>

            <h1>@dashboardConfig.Title</h1>

            <p>SignalR: @connectionStatus</p>

            <button @onclick="LoadOrders" disabled="@loading">
                Atualizar pedidos
            </button>

            <button @onclick="LogoutAsync">
                Terminar sessão
            </button>

            @if (loading)
            {
                <p>A carregar pedidos...</p>
            }

            @if (error is not null)
            {
                <p class="text-danger">@error</p>
            }

            <div class="dashboard-grid">
                @foreach (var state in VisibleStates)
                {
                    var filteredOrders = orders
                        .Where(o => o.State == state.Id)
                        .ToList();

                    <section class="state-column">
                        <h3>@state.Name (@filteredOrders.Count)</h3>

                        @if (filteredOrders.Count == 0)
                        {
                            <p>Sem pedidos</p>
                        }
                        else
                        {
                            @foreach (var order in filteredOrders)
                            {
                                <article class="order-card">
                                    <strong>@order.Code</strong>

                                    @if (dashboardConfig.ShowAreaName)
                                    {
                                        <p>@order.AreaName</p>
                                    }
                                    @foreach (var item in order.Items){
                                
                                        <p>@item.ToString()</p>
                                    }

                                    @if (dashboardConfig.CanReturnOrders.Contains(order.State))
                                    {
                                        <button @onclick="() => NextState(order.Id, -1)">Voltar</button>
                                    }

                                    @if (dashboardConfig.CanAdvanceOrders.Contains(order.State))
                                    {
                                    <button @onclick="() => NextState(order.Id, 1)">Avançar</button>
                                    }

                                </article>
                            }
                        }
                    </section>
                }
            </div>
        }
    }
}

@code {
    [Parameter]
    public string? View { get; set; }

    [SupplyParameterFromQuery(Name = "expired")]
    private bool Expired { get; set; }

    private DashboardConfig? dashboardConfig;

    private List<OrderDto> orders = new();

    private HubConnection? hubConnection;

    private IDisposable? ordersChangedHandler;

    private string connectionStatus = "A iniciar...";

    private bool loading;
    private string? error;

    private bool accessChecked;
    private bool canAccess;
    private bool checkingAccess;
    private string? checkedView;

    private IEnumerable<(int Id, string Name)> VisibleStates =>
    states.Where(s => dashboardConfig?.VisibleStates.Contains(s.Id) == true);

    protected override async Task OnParametersSetAsync()
    {
        var selectedView = (View ?? "sala")
            .Trim()
            .ToLowerInvariant();

        dashboardConfig = selectedView switch
        {
            "sala" => new DashboardConfig
            {
                Title = "Dashboard - Sala",
                AreaId = 1,
                VisibleStates = [1, 2, 3, 4],
                ShowAreaName = false,
                CanAdvanceOrders = [],
                CanReturnOrders = []
            },

            "esplanada" => new DashboardConfig
            {
                Title = "Dashboard - Esplanada",
                AreaId = 2,
                VisibleStates = [1, 2, 3, 4],
                ShowAreaName = false,
                CanAdvanceOrders = [],
                CanReturnOrders = []
            },

            "cozinha" => new DashboardConfig
            {
                Title = "Dashboard - Cozinha",
                AreaId = null,
                VisibleStates = [1, 2, 3],
                ShowAreaName = true,
                CanAdvanceOrders = [1, 2],
                CanReturnOrders = [2, 3]
            },
            "balcao" => new DashboardConfig
            {
                Title = "Dashboard - Balcão",
                AreaId = null,
                VisibleStates = [1, 2, 3, 4],
                ShowAreaName = true,
                CanAdvanceOrders = [3],
                CanReturnOrders = [4]
            },
            _ => null
        };

        orders.Clear();
        error = null;

        if (dashboardConfig is null)
        {
            error = "Dashboard não encontrado.";
            return;
        }

        var currentView = (View ?? "sala").Trim().ToLowerInvariant();

        if (checkedView != currentView)
        {
            accessChecked = false;
            canAccess = false;
        }

    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var view = (View ?? "sala").Trim().ToLowerInvariant();

        // Evitar verificações repetidas
        if (checkingAccess ||
            (accessChecked && checkedView == view))
            return;

        checkingAccess = true;
        accessChecked = false;
        canAccess = false;

        try
        {
            // Terminar uma eventual ligação anterior
            await DisposeAsync();

            // Validar a Role através da FastFoodAPI
            var allowed = await CanAccessDashboardAsync(view);

            // A página pode ter mudado durante a validação
            if (view != (View ?? "sala").Trim().ToLowerInvariant())
                return;

            canAccess = allowed;

            if (!allowed)
            {
                connectionStatus = "Acesso não autorizado.";
                return;
            }

            // Carregar apenas pedidos de um dashboard autorizado
            await LoadOrders();

            // Evitar iniciar o Hub se a página entretanto mudou
            if (view != (View ?? "sala").Trim().ToLowerInvariant())
                return;

            // Iniciar o SignalR depois da autorização
            await StartSignalRAsync(view);
        }
        catch (HttpRequestException)
        {
            canAccess = false;
            connectionStatus = "Erro de comunicação com a API.";
        }
        catch (TaskCanceledException)
        {
            canAccess = false;
            connectionStatus = "A ligação à API expirou.";
        }
        finally
        {
            // Só guardar a validação para a página atual
            if (view == (View ?? "sala").Trim().ToLowerInvariant())
            {
                checkedView = view;
                accessChecked = true;
            }
            else
            {
                checkedView = null;
                canAccess = false;
                accessChecked = false;
            }

            checkingAccess = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private readonly (int Id, string Name)[] states =
    {
        (1, "Pedido"),
        (2, "Em curso"),
        (3, "Aguarda levantamento"),
        (4, "Entregue")
    };

    private async Task NextState(int id, int operation)
    {
        error = null;
        try
        {
            if (!HostEnvironment.IsDevelopment())
            {
                error = "Autenticação de utilizadores ainda não configurada.";
                return;
            }

            var token = await BrowserAuthStorage.GetTokenAsync();

            if (string.IsNullOrWhiteSpace(token))
            {
                error = "JWT de desenvolvimento não configurado.";
                await SessionExpiredAsync();
                return;
            }

            var client = HttpClientFactory
                .CreateClient("FastFoodApi");

            // Mantém o formato que já funciona no teu endpoint
            string endpoint = $"api/orders/{id}?operation={operation}";

            using var request = new HttpRequestMessage(
                HttpMethod.Put,
                endpoint);

            request.Headers.Authorization =
                new AuthenticationHeaderValue("Bearer", token);

            using var response = await client.SendAsync(request);

            if (!response.IsSuccessStatusCode)
            {
                error = $"Erro ao atualizar o pedido: " +
                        $"{(int)response.StatusCode}";
                await SessionExpiredAsync();

                return;
            }

            await LoadOrders();

        }
        catch (HttpRequestException ex)
        {
            error = $"Erro de comunicação com a API: {ex.Message}";
        }
        catch (TaskCanceledException)
        {
            error = "A operação demorou demasiado tempo.";
        }
        
    }

    private async Task LoadOrders()
    {
        var config = dashboardConfig;

        if (config is null)
            return;

        loading = true;
        error = null;

        try
        {
            var client = HttpClientFactory
                .CreateClient("FastFoodApi");

            string endpoint = config.AreaId.HasValue
                ? $"api/orders?areaId={config.AreaId.Value}"
                : "api/orders";

            var result = await client
                .GetFromJsonAsync<List<OrderDto>>(endpoint)
                ?? new List<OrderDto>();

            if (ReferenceEquals(dashboardConfig, config))
            {
                orders = result;
            }
        }
        catch (Exception ex) when (
            ex is HttpRequestException ||
            ex is TaskCanceledException ||
            ex is System.Text.Json.JsonException)
        {
            if (ReferenceEquals(dashboardConfig, config))
            {
                error = "Não foi possível carregar os pedidos.";
            }
        }
        finally
        {
            loading = false;
        }
    }

    private async Task StartSignalRAsync(string view)
    {
        var token = await BrowserAuthStorage.GetTokenAsync();

        if (view != (View ?? "sala").Trim().ToLowerInvariant())
            return;

        if (string.IsNullOrWhiteSpace(token))
        {
            connectionStatus = "Atualização em tempo real indisponível.";
            return;
        }

        var apiBaseUrl = Configuration["Api:BaseUrl"]
            ?? throw new InvalidOperationException(
                "Endereço da API não configurado.");

        var hubUrl = new Uri(
            new Uri(apiBaseUrl),
            "hubs/orders");

        var connection = new HubConnectionBuilder()
            .WithUrl(hubUrl, options =>
            {
                // Recuperar o JWT quando o SignalR precisar dele
                options.AccessTokenProvider =
                    BrowserAuthStorage.GetTokenAsync;
            })
            .WithAutomaticReconnect()
            .Build();

        hubConnection = connection;

        // Receber alterações dos pedidos
        ordersChangedHandler = connection.On(
            "OrdersChanged",
            () => InvokeAsync(async () =>
            {
                if (!canAccess ||
                    !accessChecked ||
                    checkedView != view ||
                    view != (View ?? "sala").Trim().ToLowerInvariant() ||
                    hubConnection != connection)
                    return;

                await LoadOrders();
                StateHasChanged();
            }));

        // Ligação perdida
        connection.Reconnecting += _ =>
            InvokeAsync(() =>
            {
                if (hubConnection != connection)
                    return;

                connectionStatus = "A reconectar...";
                StateHasChanged();
            });

        // Ligação restabelecida
        connection.Reconnected += _ =>
            InvokeAsync(async () =>
            {
                if (hubConnection != connection)
                    return;

                connectionStatus = "Ligado";

                if (canAccess &&
                    accessChecked &&
                    checkedView == view &&
                    view == (View ?? "sala").Trim().ToLowerInvariant())
                {
                    await LoadOrders();
                }

                StateHasChanged();
            });

        // Ligação terminada
        connection.Closed += _ =>
            InvokeAsync(() =>
            {
                if (hubConnection != connection)
                    return;

                connectionStatus = "Desligado";
                StateHasChanged();
            });

        try
        {
            await connection.StartAsync();

            connectionStatus = "Ligado";

            // Sincronizar alterações ocorridas durante a ligação
            if (view == (View ?? "sala").Trim().ToLowerInvariant())
            {
                await LoadOrders();
            }
        }
        catch (Exception ex)
        {
            connectionStatus = $"Erro ao ligar: {ex.Message}";
        }
    }

    

    public async ValueTask DisposeAsync()
    {
        ordersChangedHandler?.Dispose();

        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }

    private async Task LogoutAsync()
    {
        // Eliminar o JWT armazenado
        await BrowserAuthStorage.LogoutAsync();

        // Terminar a ligação SignalR
        await DisposeAsync();

        // Redirecionar para o login
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    private async Task<bool> CanAccessDashboardAsync(string view)
    {
        // Dashboards públicos
        if (view is "sala" or "esplanada")
            return true;

        // Rejeitar páginas desconhecidas
        if (view is not ("cozinha" or "balcao"))
            return false;

        // Recuperar o JWT
        var token = await BrowserAuthStorage.GetTokenAsync();

        if (string.IsNullOrWhiteSpace(token))
            return false;

        // A FastFoodAPI valida o JWT e devolve a Role
        var user = await AuthApiService.GetCurrentUserAsync(token);

        if (user is null)
            return false;

        return view switch
        {
            "cozinha" =>
                user.Role is "Kitchen" or "KitchenSupervisor",

            "balcao" =>
                user.Role is "Counter" or "KitchenSupervisor",

            _ => false
        };
    }

    private async Task SessionExpiredAsync()
    {
        await BrowserAuthStorage.LogoutAsync();

        await DisposeAsync();

        Navigation.NavigateTo(
            "/login?expired=true",
            forceLoad: true);
    }

}
