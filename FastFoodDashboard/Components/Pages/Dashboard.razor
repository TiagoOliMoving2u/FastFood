@page "/dashboard/{View?}"
@using FastFoodDashboard.Models
@using System.Net.Http.Json
@using Microsoft.AspNetCore.SignalR.Client;@using Microsoft.AspNetCore.Hosting
@inject IConfiguration Configuration
@inject IWebHostEnvironment HostEnvironment
@inject IHttpClientFactory HttpClientFactory
@implements IAsyncDisposable



<nav class="dashboard-nav">
    <NavLink href="/dashboard/sala">Sala</NavLink>
    <NavLink href="/dashboard/esplanada">Esplanada</NavLink>
    <NavLink href="/dashboard/cozinha">Cozinha</NavLink>
</nav>

@if (dashboardConfig is null)
{
    <p>Dashboard não encontrado.</p>
}
else
{
    <PageTitle>@dashboardConfig.Title</PageTitle>

    <h1>@dashboardConfig.Title</h1>

    <p>SignalR: @connectionStatus</p>

    <button @onclick="LoadOrders" disabled="@loading">
        Atualizar pedidos
    </button>

    @if (loading)
    {
        <p>A carregar pedidos...</p>
    }

    @if (error is not null)
    {
        <p class="text-danger">@error</p>
    }

    <div class="dashboard-grid">
        @foreach (var state in VisibleStates)
        {
            var filteredOrders = orders
                .Where(o => o.State == state.Id)
                .ToList();

            <section class="state-column">
                <h3>@state.Name (@filteredOrders.Count)</h3>

                @if (filteredOrders.Count == 0)
                {
                    <p>Sem pedidos</p>
                }
                else
                {
                    @foreach (var order in filteredOrders)
                    {
                        <article class="order-card">
                            <strong>@order.Code</strong>

                            @if (dashboardConfig.ShowAreaName)
                            {
                                <p>@order.AreaName</p>
                            }
                            @foreach (var item in order.Items){
                                
                                <p>@item.ToString()</p>
                            }
                            
                        </article>
                    }
                }
            </section>
        }
    </div>
}

@code {
    [Parameter]
    public string? View { get; set; }

    private DashboardConfig? dashboardConfig;

    private List<OrderDto> orders = new();

    private HubConnection? hubConnection;

    private IDisposable? ordersChangedHandler;

    private string connectionStatus = "A iniciar...";

    private bool loading;
    private string? error;

    private IEnumerable<(int Id, string Name)> VisibleStates =>
    states.Where(s => dashboardConfig?.VisibleStates.Contains(s.Id) == true);

    protected override async Task OnParametersSetAsync()
    {
        var selectedView = (View ?? "sala")
            .Trim()
            .ToLowerInvariant();

        dashboardConfig = selectedView switch
        {
            "sala" => new DashboardConfig
            {
                Title = "Dashboard - Sala",
                AreaId = 1,
                VisibleStates = [1, 2, 3, 4],
                ShowAreaName = false
            },

            "esplanada" => new DashboardConfig
            {
                Title = "Dashboard - Esplanada",
                AreaId = 2,
                VisibleStates = [1, 2, 3, 4],
                ShowAreaName = false
            },

            "cozinha" => new DashboardConfig
            {
                Title = "Dashboard - Cozinha",
                AreaId = null,
                VisibleStates = [1, 2],
                ShowAreaName = true
            },

            _ => null
        };

        orders.Clear();
        error = null;

        if (dashboardConfig is null)
        {
            error = "Dashboard não encontrado.";
            return;
        }

        await LoadOrders();
    }

    private readonly (int Id, string Name)[] states =
    {
        (1, "Pedido"),
        (2, "Em curso"),
        (3, "Aguarda levantamento"),
        (4, "Entregue")
    };

    private async Task LoadOrders()
    {
        var config = dashboardConfig;

        if (config is null)
            return;

        loading = true;
        error = null;

        try
        {
            var client = HttpClientFactory
                .CreateClient("FastFoodApi");

            string endpoint = config.AreaId.HasValue
                ? $"api/orders?areaId={config.AreaId.Value}"
                : "api/orders";

            var result = await client
                .GetFromJsonAsync<List<OrderDto>>(endpoint)
                ?? new List<OrderDto>();

            if (ReferenceEquals(dashboardConfig, config))
            {
                orders = result;
            }
        }
        catch (Exception ex) when (
            ex is HttpRequestException ||
            ex is TaskCanceledException ||
            ex is System.Text.Json.JsonException)
        {
            if (ReferenceEquals(dashboardConfig, config))
            {
                error = "Não foi possível carregar os pedidos.";
            }
        }
        finally
        {
            loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        // Este teste com JWT manual é apenas para desenvolvimento
        if (!HostEnvironment.IsDevelopment())
        {
            connectionStatus = "Autenticação não configurada.";
            await InvokeAsync(StateHasChanged);
            return;
        }

        var token = Configuration["SignalR:DevAccessToken"];

        if (string.IsNullOrWhiteSpace(token))
        {
            connectionStatus = "JWT de teste não configurado.";
            await InvokeAsync(StateHasChanged);
            return;
        }

        var apiBaseUrl = Configuration["Api:BaseUrl"]
            ?? throw new InvalidOperationException(
                "Endereço da API não configurado.");

        var hubUrl = new Uri(
            new Uri(apiBaseUrl),
            "hubs/orders");

        // Criar a ligação ao Hub
        hubConnection = new HubConnectionBuilder()
            .WithUrl(hubUrl, options =>
            {
                options.AccessTokenProvider = () =>
                    Task.FromResult<string?>(
                        Configuration["SignalR:DevAccessToken"]);
            })
            .WithAutomaticReconnect()
            .Build();

        // Escutar as alterações de pedidos
        ordersChangedHandler = hubConnection.On(
            "OrdersChanged",
            async () =>
            {
                await InvokeAsync(async () =>
                {
                    await LoadOrders();
                    StateHasChanged();
                });
            });

        // Ligação temporariamente perdida
        hubConnection.Reconnecting += _ =>
            InvokeAsync(() =>
            {
                connectionStatus = "A reconectar...";
                StateHasChanged();
            });

        // Ligação restabelecida
        hubConnection.Reconnected += _ =>
            InvokeAsync(async () =>
            {
                connectionStatus = "Ligado";

                await LoadOrders();
                StateHasChanged();
            });

        // Ligação terminada
        hubConnection.Closed += _ =>
            InvokeAsync(() =>
            {
                connectionStatus = "Desligado";
                StateHasChanged();
            });

        try
        {
            await hubConnection.StartAsync();

            connectionStatus = "Ligado";

            // Sincronizar possíveis alterações desde o GET inicial
            await LoadOrders();
        }
        catch (Exception ex)
        {
            connectionStatus =
                $"Erro ao ligar: {ex.Message}";
        }

        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        ordersChangedHandler?.Dispose();

        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }

}
