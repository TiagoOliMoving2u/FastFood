@page "/admin/roles"

@using FastFoodDashboard.Models
@using FastFoodDashboard.Services

@inject RoleApiService RoleApiService
@inject PermissionApiService PermissionApiService
@inject BrowserAuthStorage BrowserAuthStorage

<PageTitle>Gestão de Roles</PageTitle>

<h3>Gestão de Roles</h3>

@if (error is not null)
{
    <p class="text-danger">@error</p>
}

@if (loading)
{
    <p>A carregar Roles...</p>
}
else if (canView)
{
    @if (canManage)
    {
        <a class="btn btn-primary mb-3"
           href="/create-role">
            + Nova Role
        </a>
    }

    @if (roles.Count == 0)
    {
        <p>Não existem Roles registadas.</p>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nome</th>
                    <th>Ações</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var role in roles)
                {
                    <tr>
                        <td>@role.Id</td>
                        <td>@role.Name</td>
                        <td>
                            @if (canManage)
                            {
                                <a class="btn btn-sm btn-outline-primary"
                                   href="@($"/edit-role?roleId={role.Id}")">
                                    Editar permissões
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private List<RoleDto> roles = new();

    private bool loading = true;
    private bool canView;
    private bool canManage;

    private string? error;

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            var token =
                await BrowserAuthStorage.GetTokenAsync();

            if (string.IsNullOrWhiteSpace(token))
            {
                error = "Sessão expirada. Faz login novamente.";
                return;
            }

            var permissions =
                await PermissionApiService.GetMyPermissionsAsync(
                    token);

            canView = permissions.Contains("roles.view");
            canManage = permissions.Contains("roles.manage");

            if (!canView)
            {
                error = "Não tens permissão para consultar Roles.";
                return;
            }

            roles = await RoleApiService.GetRolesAsync(token);
        }
        catch (HttpRequestException ex)
        {
            error = $"Erro ao carregar Roles: {ex.Message}";
        }
        finally
        {
            loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}
