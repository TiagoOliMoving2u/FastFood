@using FastFoodDashboard.Models
@using FastFoodDashboard.Services
@using System.Net

@inject RoleApiService RoleApiService
@inject PermissionApiService PermissionApiService
@inject BrowserAuthStorage BrowserAuthStorage
@inject AuthApiService AuthApiService

@page "/edit-pass"

<PageTitle>Repor palavra-passe</PageTitle>

<div class="container py-4" style="max-width: 750px;">

    <!-- Cabeçalho -->
    <div class="d-flex justify-content-between
        align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">Repor palavra-passe</h2>
            <p class="text-muted mb-0">
                Definir uma nova palavra-passe para o funcionário.
            </p>
        </div>

    </div>

    @if (error is not null)
    {
        <div class="alert alert-danger">@error</div>
    }

    @if (success is not null)
    {
        <div class="alert alert-success">@success</div>
    }

    <!-- Cartão de segurança -->
    <div class="card shadow-sm rounded-3 mb-4">

        <div class="card-header bg-transparent py-3">
            <h5 class="mb-0">
                Segurança da conta
            </h5>
        </div>

        <div class="card-body p-4">

            <!-- Identificação -->
            <div class="bg-light border rounded-3 p-3 mb-4">
                <div class="fw-semibold">
                    Utilizador selecionado
                </div>

                <div class="text-muted small">
                    ID: @UserId
                </div>
            </div>

            <!-- Nova password -->
            <div class="mb-3">

                <label class="form-label fw-semibold">
                    Nova palavra-passe
                </label>

                <input class="form-control"
                       type="@(showPassword ? "text" : "password")"
                       placeholder="Introduzir nova palavra-passe"
                       autocomplete="new-password"
                       @bind="newPassword"
                       @bind:event="oninput" />

                <div class="form-text">
                    Recomendado: pelo menos 12 caracteres.
                </div>
            </div>

            <!-- Confirmar password -->
            <div class="mb-3">

                <label class="form-label fw-semibold">
                    Confirmar nova palavra-passe
                </label>

                <input class="form-control"
                       type="@(showPassword ? "text" : "password")"
                       placeholder="Repetir nova palavra-passe"
                       autocomplete="new-password"
                       @bind="confirmPassword"
                       @bind:event="oninput" />

                @if (!string.IsNullOrEmpty(confirmPassword)
                    && newPassword != confirmPassword)
                {
                    <div class="text-danger small mt-2">
                        As palavras-passe não coincidem.
                    </div>
                }
            </div>

            <!-- Mostrar password -->
            <div class="form-check mb-4">

                <input class="form-check-input"
                       type="checkbox"
                       id="showPassword"
                       @bind="showPassword" />

                <label class="form-check-label"
                       for="showPassword">
                    Mostrar palavra-passe
                </label>
            </div>

            <!-- Informação -->
            <div class="alert alert-info mb-0">
                Após a reposição, o funcionário deverá utilizar
                a nova palavra-passe para iniciar sessão.
            </div>

        </div>
    </div>

    <!-- Botões -->
    <div class="d-flex justify-content-end gap-2">

        <a href="@("/admin/users")"
           class="btn btn-outline-secondary">
            Voltar
        </a>

        <button class="btn btn-primary"
                @onclick="SavePasswordAsync"
                disabled="@(saving || !CanSave)">

            @(saving
                ? "A guardar..."
                : "Repor palavra-passe")
        </button>

    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "userId")]
    public int UserId { get; set; }

    private string newPassword = string.Empty;
    private string confirmPassword = string.Empty;

    private bool showPassword;
    private bool saving;

    private string? error;
    private string? success;

    private bool CanSave =>
        newPassword.Length >= 12 &&
        newPassword == confirmPassword;

    private async Task SavePasswordAsync()
    {
        try
        {
            var token = await BrowserAuthStorage.GetTokenAsync();

            if (string.IsNullOrWhiteSpace(token))
            {
                error = "Sessão expirada. Faz login novamente.";
                return;
            }
        error = null;
        success = null;

        if (!CanSave)
            return;

            var status = await AuthApiService.UpdateUserPasswordAsync(UserId, newPassword, token);

            if (status == HttpStatusCode.OK ||
                    status == HttpStatusCode.NoContent)
            {
                success = "Palavra-passe do Utilizador atualizada com sucesso!";
            }
            else if (status == HttpStatusCode.BadRequest)
            {
                error = "Verifica os dados introduzidos.";
            }
            else if (status == HttpStatusCode.NotFound)
            {
                error = "Utilizador não encontrado.";
            }
            else if (status == HttpStatusCode.Forbidden)
            {
                error = "Não tens permissão para editar este Utilizador.";
            }
            else if (status == HttpStatusCode.Unauthorized)
            {
                error = "Sessão inválida ou expirada.";
            }
            else
            {
                error = $"Erro ao guardar: HTTP {(int)status}";
            }
        }
        catch (HttpRequestException ex)
        {
            error = $"Erro de comunicação: {ex.Message}";
        }
        finally
        {
            //loading = false;
            //await InvokeAsync(StateHasChanged);
        }
    }
}