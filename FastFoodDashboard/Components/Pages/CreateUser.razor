@using FastFoodDashboard.Models;
@using FastFoodDashboard.Services

@inject AuthApiService AuthApiService
@inject BrowserAuthStorage BrowserAuthStorage

@page "/create-user"

<PageTitle>Create User</PageTitle>

@if (error is not null)
{
    <p class="text-danger">@error</p>
}

<label>Username</label>
<br />
<input @bind="username" type="text" />
<br />
<label>Password</label>
<br />
<input @bind="password" type="password" />
<br />
<label>Confirm Password</label>
<br />
<input @bind="confirmPassword" type="password" />
<br />
<select @bind="selectedRole">
    <option value="0">Selecionar área</option>
    @foreach (var role in roles)
    {
        <option value="@role.Id">@role.Name</option>
    }
</select>
<br />
<button @onclick="@CreateUserAsync">Create User</button>

@code {
    private string? error;
    private string? username;
    private string? password;
    private string? confirmPassword;

    private int selectedRole = 0;
    private List<RoleDto>? roles = new();

    protected override async Task OnInitializedAsync()
    {
        await GetRolosAsync();
    }

    private async Task GetRolosAsync()
    {
        try
        {
            var token = await BrowserAuthStorage.GetTokenAsync();

            if (string.IsNullOrWhiteSpace(token))
            {
                error = "JWT de desenvolvimento não configurado.";
                return;
            }

            roles = await AuthApiService.GetRolesAsync(token);
        }
        catch (Exception ex)
        {
            error = "Erro ao carregar as roles." + ex.ToString();
        }
    }

    private async Task<bool> ValidateInputs()
    {
        if (string.IsNullOrWhiteSpace(username))
        {
            error = "Username é obrigatório.";
            return false;
        }
        else if (string.IsNullOrWhiteSpace(password))
        {
            error = "Password é obrigatório.";
            return false;
        }
        else if (string.IsNullOrWhiteSpace(confirmPassword))
        {
            error = "Confirm Password é obrigatório.";
            return false;
        }
        else if (selectedRole == 0)
        {
            error = "Selecione uma role.";
            return false;
        }
        return true;
    }

    private async Task<bool> ConfirmPassowrd()
    {
        if (password == confirmPassword)
            return true;

        error = "Passwords não coencidem!";
        return false;
    }

    private async Task CreateUserAsync()
    {
        if (!await ConfirmPassowrd() || !await ValidateInputs())
            return;
        try
        {
            var token = await BrowserAuthStorage.GetTokenAsync();
            if (string.IsNullOrWhiteSpace(token))
            {
                error = "JWT de desenvolvimento não configurado.";
                return;
            }
            
            var createUserRequest = new CreateUserRequest
            {
                Username = username!,
                Password = password!,
                Role = roles!.FirstOrDefault(r => r.Id == selectedRole)!.Name
            };

            Console.WriteLine(roles!.FirstOrDefault(r => r.Id == selectedRole)!.Name);

            await AuthApiService.CreateUserAsync(token, createUserRequest);

            error = "Utilizador criado com sucesso!";
        }
        catch (Exception ex)
        {
            error = "Erro ao criar o utilizador." + ex.ToString();
        }
    }
}
