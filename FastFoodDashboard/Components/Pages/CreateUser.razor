@using FastFoodDashboard.Models;
@using FastFoodDashboard.Services
@using System.Net

@inject RoleApiService RoleApiService
@inject AuthApiService AuthApiService
@inject BrowserAuthStorage BrowserAuthStorage
@inject ILogger<CreateUser> Logger

@page "/create-user"

<PageTitle>Create User</PageTitle>

<h3>Criar novo Utilizador</h3>

@if (error is not null)
{
    <p class="text-danger">@error</p>
}

@if (success is not null)
{
    <p class="text-success">@success</p>
}

@if (loading)
{
    <p>A carregar roles...</p>
}
else if (rolesLoaded)
{

<label>Username</label>
<br />
<input @bind="username" type="text" />
<br />
<label>Password</label>
<br />
<input @bind="password" type="password" />
<br />
<label>Confirm Password</label>
<br />
<input @bind="confirmPassword" type="password" />
<br />
<select @bind="selectedRole">
    <option value="0">Selecionar role</option>
    @foreach (var role in roles)
    {
        <option value="@role.Id">@role.Name</option>
    }
</select>
<br />
<button @onclick="@CreateUserAsync">Create User</button>
}
@code {
    private string? error;
    private string? success;

    private string? username;
    private string? password;
    private string? confirmPassword;
    private bool loading = true;
    private bool rolesLoaded = false;

    private int selectedRole = 0;
    private List<RoleDto>? roles = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        rolesLoaded = false;

        try
        {
            var token = await BrowserAuthStorage.GetTokenAsync();

            if (string.IsNullOrWhiteSpace(token))
            {
                error = "Sessão indisponível ou expirada. " +
                        "Inicia sessão novamente.";
                return;
            }

            roles = await RoleApiService.GetRolesAsync(token) ?? new();

            rolesLoaded = true;

            if (roles.Count == 0)
                error = "Não existem roles disponíveis.";
        }
        catch (HttpRequestException ex)
        {
            Logger.LogError(ex, "Erro ao carregar perfis.");

            error = ex.StatusCode switch
            {
                HttpStatusCode.Unauthorized =>
                    "Sessão expirada. Inicia sessão novamente.",

                HttpStatusCode.Forbidden =>
                    "Não tens permissão para consultar os perfis.",

                _ => "Não foi possível carregar os perfis. Tenta novamente."
            };
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Erro ao carregar perfis.");
            error = "Não foi possível carregar os perfis. Tenta novamente.";
        }
        finally
        {
            loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task<bool> ValidateInputs()
    {
        if (string.IsNullOrWhiteSpace(username))
        {
            error = "O nome de utilizador é obrigatório.";
            return false;
        }
        else if (string.IsNullOrWhiteSpace(password))
        {
            error = "A palavra-passe é obrigatória.";
            return false;
        }
        else if (string.IsNullOrWhiteSpace(confirmPassword))
        {
            error = "Confirma a palavra-passe.";
            return false;
        }
        else if (selectedRole == 0)
        {
            error = "Selecione uma role.";
            return false;
        }
        return true;
    }

    private async Task<bool> ConfirmPassowrd()
    {
        if (password == confirmPassword)
            return true;

        error = "As palavras-passe não coincidem.";
        return false;
    }

    private async Task CreateUserAsync()
    {
        error = null;
        success = null;
        if (!await ValidateInputs() || !await ConfirmPassowrd())
            return;
        try
        {
            var token = await BrowserAuthStorage.GetTokenAsync();
            if (string.IsNullOrWhiteSpace(token))
            {
                error = "Sessão indisponível ou expirada. Inicia sessão novamente.";
                return;
            }
            
            var createUserRequest = new CreateUserRequest
            {
                Username = username!,
                Password = password!,
                Role = roles!.FirstOrDefault(r => r.Id == selectedRole)!.Name
            };

            Console.WriteLine(roles!.FirstOrDefault(r => r.Id == selectedRole)!.Name);

            var created = await AuthApiService.CreateUserAsync(
                token,
                createUserRequest);

            if (!created)
            {
                error = "A sessão expirou ou não tens permissão para criar utilizadores.";
                return;
            }

            success = "Utilizador criado com sucesso!";
            error = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Erro ao criar utilizador.");

            error = "Não foi possível criar o utilizador. " +
                    "Verifica os dados e tenta novamente.";
        }
    }
}
